<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:angle="315"
                android:endColor="#3B1E78"
                android:startColor="#141834"
                android:type="linear" />
        </shape>
    </item>
    <!-- мягкое свечение в правом верхнем углу -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:centerX="0.95"
                android:centerY="0.05"
                android:endColor="#0022D3EE"
                android:gradientRadius="160dp"
                android:startColor="#4022D3EE"
                android:type="radial" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <stroke android:width="1dp" android:color="#26FFFFFF" />
        </shape>
    </item>
</layer-list>
